rules_version = '2';

// Don hang chua ten, so dien thoai va dia chi cua khach.
// Chi Cloud Function (dung Admin SDK, bo qua rules) duoc phep dong vao du lieu nay.
// Moi truy cap tu trinh duyet deu bi tu choi.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
