{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ],
  "firestore": {
    "database": "tuongot",
    "rules": "firestore.rules"
  },
  "hosting": [
    {
      "target": "tuongot-sieucay",
      "public": ".",
      "ignore": [
        "firebase.json",
        "firestore.rules",
        "**/.*",
        "**/node_modules/**",
        "functions/**"
      ],
      "rewrites": [
        {
          "source": "/api/order",
          "function": {
            "functionId": "order",
            "region": "asia-southeast1"
          }
        }
      ]
    },
    {
      "target": "tuongotsieucay",
      "public": ".",
      "ignore": [
        "firebase.json",
        "firestore.rules",
        "**/.*",
        "**/node_modules/**",
        "functions/**"
      ],
      "rewrites": [
        {
          "source": "/api/order",
          "function": {
            "functionId": "order",
            "region": "asia-southeast1"
          }
        }
      ]
    }
  ]
}
